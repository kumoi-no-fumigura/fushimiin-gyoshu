 "poems": [
  {
   "seq": "1",
   "text": "今日ははやそらも日影ものどけきは春きぬと思ふ心よりかも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "あらたまの春の初音の今日ぞとは手にとる松の色に見えけり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "冬にあまる寒きこころの殘りてや春の雪とはなるにあるらむ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "春あさき雪の消え間にすくなくて若菜みじかき春日野のはら",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "聞く人の心をはるにもよほして時知り顏にうぐひすのなく",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "ひらけそむる梅をはじめの色にして數多の花もこれよりぞ咲く",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "秋とてもいさ白雲の春のかりさしもわかれのさだめなき世に",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "夜もすがら草のみどりを染めてけりあさけの庭の春雨のいろ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "櫻色に雲もかすみもうつりけり花のさかりのきさらぎのやま",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "かくて世にふる野の蕨をりふしも知らでぞ過ぐす物うかる身は",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "五月闇はやまをわけてともす火にうきめをみねの鹿ぞかなしき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あやめ草なにかこの世の濁江にしひてこころのひかれしもせむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "神垣や今日のまつりにかざすてふ時にあふひの名こそかれせね",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "なべて世の卯月を時と咲けばにやこと名をからぬ花にはあるらむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "なれて後かはるはこれもあはれなりかりの衣の色とおもへど",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "花鳥もなるるとなしのすさびにてまた春つくる今日もきにけり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "春の色のとまるとなしに山吹の花もてせける井手のしがらみ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "花のあとはみどりになれる木蔭よりかかるや藤の色もなつかし",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "かきつばた池のみぎはを咲きめぐり水の色さへはるふかき頃",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "草深みあれたる宿にこととへばふるき垣ほにすみれ摘むなり○",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "をちかたの山の端たえて今日いくかおなじ雲なる五月雨の空",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "吹きすさぶゆふべの風に露おちて村雨おもきのきのたちばな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "飛ぶ螢もえつつゆけどよそに見るかげは凉しき物にぞありける",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "月をいとふ里のつづきか軒ごとに煙ぞならぶ蚊やり火のやど",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "おつと見る池のはちすの白露は浮葉のたまとまたなりにけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "あだにのみ消ゆと思ひし雪こほり氷室にのこる姿をぞみる",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "夏知らぬこころやみえむせきいるる〓水凉しきやどの氣色に",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "みそぎする河邊涼しく吹く風にぬさもとりあへず秋や立つらむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "今日しやがて何のうれへのあるとなみ秋とし聞くに物ぞ侘しき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "雲井にてながめ馴れにしそのかみの秋もこひしき星合のそら",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "葉をきよみ露のひかりは凉しくて今朝花みゆる庭のはぎはら○",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "名ばかりや人はめでける女郞花をらで過ぐべき姿ならぬを",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "長月や身にしむ風の夜をかさねうつやきぬたの聲いそぐなり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "朝がほよなべての花のひとさかりそれだにあだの色ならずやは",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "夜すがらの思をうれへかはすらし諸聲になく野邊のむしの音",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "思ひみだす心こそなほはかなけれあしたの露のあだしこの世を",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "分けつくす野原しの原おしなべてのがれぬ秋と鹿や鳴くらむ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "袖かけて露ぞ色なるふぢばかま紐とくころの野邊のあきかぜ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "いでそむる尾花が穂ずゑ短くてなびかす風ぞ庭にすくなき",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "降るほどはくもりかすめる雪の色を朝日にみがく遠の山の端",
   "kana": "",
   "speaker": "なるかるかやの穗ずゑの露はかぜもみださず",
   "page": 13,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "寒くなる水の心のむすぼほれ冬はこほりとなるにやあるらむ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "おきて見る朝けの軒は霜しろみまがふや雪のいろとみるまで",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "こほりとくる池の水鳥うきて世に住みがたしとや思ひ知るらむ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "ねざめする板屋の閨の村時雨降るも過ぐるもさだかにぞ聞く",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "昨日よりも今朝は嵐のはげしきや冬にかはれるしるしなるらむ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "枯れまさる草木を時の姿にてあきてふ名にも今日しわかれぬ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "秋の色も染めかはるべき時しあれば時雨もふりて木木ももみぢぬ",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "秋深き庭のまがきの霜がれにひとりさかりのしらぎくのはな",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "あじろ木にいざよふ波のよるよるは心やさわぐ宇治のはし姫",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "かご山やさかき葉白くおく霜のこころとけける神あそびかな",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "朝風に寒き野原をかりゆけばころも手さえてあられちりかふ",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "うづもれぬ煙を見せて雪のうちもそことはしるき小野の炭竈",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "庭の雪はすだれへだつる閨の中にまだおく深きうづみ火のもと",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "いたづらのながめの月日移りきていそがぬ宿も年やくれぬる",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "知られじなよその浦路に漕ぐ舟のほのみし波を袖にかくとは",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "ことわりの浮名にまけて今日までは人のつつむに任せてぞ經る",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "深く思ふわが心までをちぎりにてむなしき人に身をやかへてむ",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "なげきつるあはれ多くの年月にかへてはかなき夜はのひととき",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "わかれてもわかるとはなし君にそふ心は身にもまだかへらねば",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "戀ひしとも今更人にいひがたみわれさへうとくなるぞ悲しき",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "思ひよらぬ旅のかりねの一夜しもつねにまさりて妹ぞ戀しき",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "なれすぐる月日にそへて思ひまさる人の哀のきはぞ知られぬ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "思へども人のなさけは人をわけば我が哀をばわれのみぞしる",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "ためしなくつらき限やこのきはと思ひしうへのうさもありけり",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "この頃のねざめになれてさ夜深き鳥の初音をかならずぞ聞く",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "賴むかげのみどりはなほも常磐なれはこやの山の古き松が枝",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "あはれなり世のうきふしは知りながらさすがつれなき庭の吳竹",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "和歌の浦やむれゐるたづも音をぞなくさりにし友の數を戀ひつつ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "かくてしもしばしの身をばやどしてむ岩根のとこの苔の筵に",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "春はまづかすみをわけし八幡山見しよに神もこころへだつな",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "人の世はとまらぬ波のはやせ川ゆきてかへらぬはてぞ悲しき",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "露にしぼり嵐にほしてたび衣野邊も山路もいくかわけきぬ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "またと見ぬならひの更にかなしきは馴れて別れし百敷のやど",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "浮き沈み世をうみわたるあま舟の行末知らぬ身にこそありけれ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "あだし野の草葉にかかる白露のただ消えぬまの身にこそありけれ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "筆のあとに我が心をばとどめおけどあはれを誰れか殘しても見む",
   "kana": "",
   "speaker": "かけ橋こけ深み世わたる道はさぞなあやふき",
   "page": 16,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "數數にのこれる玉の聲はあれどその世の人のとまれるはなし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "あめつちのやはらぐ國のことわざのさかりにとめる敷島の道",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "はかなくも身をいつまでと定めてか後とは物を思ふなるらむ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "まよふうちは現とみるも夢ならば嬉しきゆめの現なれかし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "睦月立つあしたむかへて諸人のいはふ心やみなかよふらし",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "春きては幾日も經ぬをうぐひすののどけき聲にはやも鳴くかな",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "春がすみたなびく暮を見渡せば四方の山邊ぞうすくなりゆく",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "霞む日の波路のどけき夕なぎにあまた行きかふ浦のつりぶね",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "風まぜに雪ふりあるる今日の日は春しもなほぞさえまさりける",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "子の日にや今日は出でつる諸人の小松が原に引きつれてゆく",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "春淺き雪げの水に袖ぬれて澤田のわか菜今日ぞ摘みつる",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "いたづらに野邊の蕨のをりふしも知らぬわが身の春ぞ物うき",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "吹く風の夜ふかき窓に匂はずば梅のありかは知られざらまし",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "道の邊やたれぬしならぬ梅の花往來のひとのかざしとぞなる",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "山遠きむかへの河のかは岸になびきてたてるやなぎひともと",
   "kana": "",
   "speaker": "",
   "page": 17,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "雲ふかき空はけさよりくもりつづき夕暮わかぬはるさめのうち",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "曇るとてうらみし秋の月かげにかすむそこ路のあはれとはなる",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "消えまさる翅もはては見えずなりぬ霞める山を越ゆるかりがね",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "われ見ずばかたみともなれ植ゑそふる宿のさくらは行末の雲",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "さくら花みやこのつとのためばかり一枝ゆるせ春のやまもり",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "散りぬなり惜むによらぬ人の世のわかれは花ものがれやはする○",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "梢にははなもあとなしやまぶきのまがきに春のいろを殘して",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "春はけふ今日も夕の今の身にかぎる名殘をいかにながめむ○",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "かこひすつる賤が園生の垣根までなさけぞ見ゆる卯の花の頃",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "さしかはす軒の綠の夕こかげまだ夏あさきいろぞすずしき",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "二度とききかさねばやほととぎす初音ののちの今日の一こゑ",
   "kana": "",
   "speaker": "",
   "page": 18,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "あやめおふる沼の入江の五月雨にあまるや水のゆく方もなし",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "すずむとてすだれをまけばうたた寐の袖まで白き軒の月かげ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "とぶ螢草葉をやくと見えながらひかりはなほぞ凉しかりける",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "つづき立つ杜のしげみの夕木蔭ゆけども同じせみのもろごゑ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "風やつぐる心やおもふいつしかの秋にうれふる暮のながめは○",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "あまの川もみぢの橋の秋よりや色かはらじと契りそめけむ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "過ぎてゆくゆふべの庭の秋風をしたひがほなる荻のうへかな",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "宮城野の木の下道のゆきずりに袖にいろなす萩のしらつゆ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "花すすき草の袂もつゆおもしあしたの原の霧のあさあけ",
   "kana": "",
   "speaker": "",
   "page": 19,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "ふるさとやあれ行く庭の淺茅原つゆふかしとて誰れか拂はむ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "今朝もなほ雨よこぎりて風もやまず村雲さわぎ千草みだれて",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "うれへそふ秋とてなにかかこたましただ村雲の夕ぐれのそら",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "草のもとは蟲の音ならぬ方もなし露わけてゆく秋のよの野邊",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "秋風に雲もうき立つゆふぐれの空にぞわたるかりのひとつら",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "聲のみぞかすかに通ふさをしかのおのが鳴く野は霧に隱れて",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "月はなほ山のあなたの空や遠きまだみねくらき松風のおと",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "思ひみれば住みこしかたも行末もともにきはなき秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "いりはてむ後もしばしの短夜をのこすもおなじあたら夜の月",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "こずゑ深ききりの雫は雨とおちてあけぼのくらき軒の山かげ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "たがひまやねずときかする里つづききぬたの音ぞ數多聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "咲き匂ふおなじかぎりの色ながら日數ぞうつる庭のしらぎく",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "しぐれそはむ梢の色を殘しおきてまづ下染のつゆのひといろ",
   "kana": "",
   "speaker": "",
   "page": 20,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "散りそむる後はいくかの色もあらじ嵐をまぜぬ木の葉なりとも",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "しぐれはつる日數ほどなき長月のむなしき名にぞ秋は盡きぬる",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "まきのやの寢覺のうちも幾時雨過ぎては音のまたきほふらむ",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "朝な朝な霜のふる野の冬枯にあきの千草のそのあともなし",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "夕ぐれや近き垣根の竹の葉をうつや霰のこぼれてぞちる",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "白妙につもれる雪の一村を松に吹きなすやまおろしのかぜ",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "隔てつる竹のかこひは折れふして庭につづける雪のやまもと",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "末うくる谷のかけひも絕えぬらし氷りてとまる山河のみづ",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "鐘のほどに夜深き霜のおきて見むあかつきがたの月ぞ寒けき",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "波さわぐなごのみなとの浦風に入江の千鳥むれてたつなり",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "物おもふ知られぬ時やうつりぬる灰しろくなる夜のうづみ火",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "急ぐべき春のこころも知らぬ身は長閑におくる年のくれかな",
   "kana": "",
   "speaker": "",
   "page": 21,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "あやにくにやどるか袖の夜半の月なみだありとは人につつむを",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "思ふ人袖にもせめてふれもせよ戀ひあまる日のくれのあき風",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "あま雲のうきたる人を戀ひそめて絕えず心にかかるくれかな",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "この暮は雨のさはりと思ひなして今日ばかりだに人をかこたじ",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "契りなれし人の昔を思ひいでてひとり空しき夕をぞみる",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "わびてぬるこよひの心うかれ行きて人の爲にも見えよとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "うきなかはただもろこしの吉野山したふ心やおくれじとする",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "身をしればえぞいはしろの野邊の松久しきこひに結びなれても",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "龍田川紅葉のにしきそれよりもわがうき中ぞなほ絕えぬべき",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "世とともにしをるる袖の浦波のたちゐに妹をかけてこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "幾夜われつれなき色にこひわびぬ淚しぐれのふるのかみすぎ",
   "kana": "",
   "speaker": "",
   "page": 22,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "つひに人かれけるものを秋萩の下葉のいろを何うらみけむ",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "さしてとふ夕のとりのゆくかたもわれぞ泣く泣くひとり眺むる",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "つひにさて思消えなば夏蟲のもえこがれてのはてぞかひなき",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "言の葉のかはるとなしにかはりけむ心のかはる人のたまづさ",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "わが方に心もよらぬあま舟はこと浦なみにへだたりぞゆく",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "星〓くはれたるみねは靜にてまつかぜ高きあかつきのやま○",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "野邊とほき夕日のすゑの山本に一筋しろきけぶりをぞみる",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "ともしなきいほりの軒の夜の雨ひとり心にききあまりぬる",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "ひましらむ閨の光を待ちつけてこころときゆる窓のともし火",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "八重とづる苔はいつものみどりにて春秋わかぬ庭のいろかな",
   "kana": "",
   "speaker": "",
   "page": 23,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "いかにせむ入江にしげるよしあしも皆假の世と思ひなさずば",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "山深きやどのすまひは朝夕の雲のたちゐを軒端にぞ見る",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "山里のゆふべは人もおとづれず嵐ぞわたるみねの檜はらに",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "ねざめするふしみの田井の曉に鴫の羽おとぞちかくきこゆる",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "いたづらに花も紅葉もいくうつり月日も知らぬ宿のながめに",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "あれまくの軒端の草の名にも思へむかしにもあらぬ宿の心を",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "越えきつる山の幾重のへだてにて雲にあとなきふる里のそら",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "思ふかたのことかたらなむ友もがな草の枕のたびのまろねに",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "うちもねず浦のとまやの波枕よるよるひとりこころくだけて",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "あらぬ身のあらぬ心になしてこそありうき世にはあり渡りけれ",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "むば玉の夢てふものはなき人の二度あはむためにぞありける",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "四方におよぶもとの誓のあまりより塵にもうつる光をぞみつ",
   "kana": "",
   "speaker": "",
   "page": 24,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "照らしすむ心のつきの〓ければ雲のさはりは目にもかからず",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "民やすく國をさまりて天地のうけやはらぐるこころをぞ知る○",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "み雪降り世は寒けれどうぐひすの今朝なく聲の春にもある哉",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "梅の花したてる庭の夕づくひ暮れうつりゆく色ぞほどなき",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "あはれ今は身をいたづらの眺してわが世ふりゆく花の下かげ",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "聲よりも姿やしのぶほととぎす月なきよひのやみに鳴くなり",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "今日までは五月の日數さながらにをやまぬ雨の中に過ぎぬる",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "流れゆく水の心は凉しけれど螢の火をばけたずぞありける",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "風はやみ雲のひとむら峯こえて山みえそむる夕立のあと",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "秋ならぬただあき風の夕暮よ山かげふかきまつのひびきに",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "なびきあへる花の末より露ちりて萩の葉しろき庭のあきかぜ",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "秋風の閨すさまじく吹くなべにふけて身にしむとこの月影",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "鹿の音もはやしるべせよ今日まではわくる道なき春日野の原",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "山深み朝霧はれぬ軒の空にわたるやかりのこゑぞまぢかき",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "誘ひゆくさほ山嵐まてしばしははその紅葉あき深きころ",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "染めおとす木木の木の葉を庭にしきて時雨の音に冬ぞきこゆる",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "なつみ川かは音絕えてこはる夜に由かげ寒み鳴ぞなくなる○",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "わが世にはあつめぬ和歌の浦千鳥むなしき名をや跡に殘さむ○",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "降りおもるよなよなごとに折れそひて雪にしかるる庭の吳竹",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "ほしうたふ聲や雲井にすみぬらむ空にもやがて影のさやけき",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "忍べばとただその方にかこつにぞさらば顯れてみばやとも思ふ",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "一筋にかけはなれぬにたゆませてそこをつれなく過ぎむとやする",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "類なき今宵のうさに思ひこりて明日ばかりだに待たれずもがな",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "そのままにそはまし見ましいたづらに惜しや逢はばやよその年月",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "われも人も恨みたちぬるなかなれば今はさこそと哀なるかな",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "明けぬべき空の氣色になりてしも雲はいろこきあかつきの山",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "思ふかたの夢はしばしの名殘にて寐覺うれしき夜半のひと時",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "里やいづく野邊はるかなる旅のくれに夕山白くけぶり立つ見ゆ",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "山あらしの過ぎぬと思ふ夕暮におくれてさわぐ軒のまつが枝",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "石〓水神のながれをうけつぎて絕えずぞすまむ萬代までに",
   "kana": "",
   "speaker": "",
   "page": 27,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  }
 ],
